OPENAI_API_KEY=sk-your-key-here
# OpenAI model for translation + VI loanword fix (Chat Completions only).
# Best: gpt-5.5-2026-04-23 | Also OK: gpt-5.5, o3, gpt-4.1, gpt-4o, o4-mini
# NOT supported: gpt-5.5-pro (Responses API only)
OPENAI_MODEL=gpt-5.5-2026-04-23

# Translation tone for OpenAI: economics | everyday | humor
TRANSLATION_TOPIC=economics

# Translation provider: openai | gemini | google
# google = free Google Translate via deep-translator (use on servers where OpenAI/Gemini are geo-blocked)
TRANSLATION_ENGINE=openai

# Gemini API (only required when TRANSLATION_ENGINE=gemini)
# Prefer numbered keys; on 429/quota the app rotates to the next key automatically.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Legacy single-key alias still supported: GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Translation: segments per OpenAI request (more context = more natural; max 50)
TRANSLATION_BATCH_SIZE=30

# Phrase grouping: max consecutive cues per phrase group sent to GPT (1-20, default 6)
# Larger = more sentence context per group; smaller = more granular grouping
PHRASE_GROUP_MAX_CUES=6

# Subtitle appearance
# SUBTITLE_STYLE_MODE: rounded (modern, Pillow) | classic (ASS/libass, rectangular)
SUBTITLE_STYLE_MODE=rounded
SUBTITLE_FONT_SIZE=55
SUBTITLE_FONT_COLOR=#9333EA
SUBTITLE_BACKGROUND_COLOR=#FFFFFF
SUBTITLE_BACKGROUND_OPACITY=0.92
SUBTITLE_MARGIN_BOTTOM=32
SUBTITLE_REFERENCE_HEIGHT=1920

# Rounded mode options (only used when SUBTITLE_STYLE_MODE=rounded)
SUBTITLE_BORDER_RADIUS=18
SUBTITLE_PADDING_X=28
SUBTITLE_PADDING_Y=16
# Extra top/bottom room (px at reference height) for Vietnamese diacritics and descenders
SUBTITLE_TEXT_SAFE_PADDING_Y=12
SUBTITLE_MAX_WIDTH_RATIO=0.86
SUBTITLE_LINE_SPACING=1.2
SUBTITLE_BOTTOM_MARGIN_RATIO=0.11

# Classic mode only
SUBTITLE_BOX_PADDING=14

# VI mode: use OpenAI to fix English loanwords mis-transcribed by ASR (true/false)
VI_LOANWORD_OPENAI_FIX=true

# Set to true to print per-group cue text and EN/VI sample pairs in console (false by default)
DRAKONSUB_DEBUG=false

# Vietnamese Subtitle Readability Optimizer
# Shorten verbose Vietnamese text so it fits within the display window.
# Stage 1: rule-based (always fast, zero cost).
# Stage 2: OpenAI rewrite for cues still above hard_cps (opt-in, uses OPENAI_API_KEY).
ENABLE_VI_READABILITY_OPTIMIZER=true
VI_READABILITY_USE_OPENAI=false
VI_READABILITY_TARGET_CPS=17
VI_READABILITY_MAX_CPS=22
VI_READABILITY_HARD_CPS=26

# Vietnamese Subtitle Timing Optimizer
# Adjust cue duration so Vietnamese text is readable at the target reading speed.
# Set to false to disable entirely and keep original English SRT timing.
ENABLE_VI_TIMING_OPTIMIZER=true

# Target reading speed: slow (14 CPS) | normal (17 CPS) | fast (20 CPS)
VI_SUBTITLE_READING_SPEED=normal

# --- Production / Docker ---
# Web bind (use 0.0.0.0 inside containers)
DRAKONSUB_HOST=0.0.0.0
DRAKONSUB_PORT=8000
# Persistent job storage (uploads, outputs, URL imports)
DRAKONSUB_JOBS_ROOT=/app/data/jobs
# Whisper ASR model for English: small | medium | large (VI uses PhoWhisper separately)
WHISPER_MODEL=small
# Public domain for reverse proxy (Caddy), e.g. sub.example.com
DRAKONSUB_DOMAIN=

# YouTube cookies for URL import on cloud servers (Netscape format). Do not commit.
YT_DLP_COOKIES_FILE=/app/data/youtube-cookies.txt

# YouTube external download APIs (cascade order: video-download-api -> Tunelio -> Captapi -> yt-dlp)
# Video Download API: https://video-download-api.com/api
# VIDEO_DOWNLOAD_API_KEY_1=...
# VIDEO_DOWNLOAD_API_KEY_2=...
# VIDEO_DOWNLOAD_API_KEY_3=...
# VIDEO_DOWNLOAD_API_KEY_4=...
# Captapi: https://captapi.com/dashboard/api-keys
# CAPTAPI_API_KEY_1=capt_live_...
# CAPTAPI_API_KEY_2=capt_live_...
# CAPTAPI_API_KEY_3=capt_live_...
# CAPTAPI_API_KEY_4=capt_live_...
# Tunelio: https://tunelio.dev/
# TUNELIO_API_KEY=tnl_...

# Saydi TTS (voiceover / thuyết minh — backend only, never expose to frontend)
# SAYDI_TTS_API_URL=https://api.voice.saydi.ai/tts
# SAYDI_TTS_API_TOKEN=
# SAYDI_TTS_MODEL=k2-fsa/OmniVoice
# SAYDI_TTS_SAMPLE=ng-c-huy-n-2-0-69140efab3d5d05406bafb22
# SAYDI_TTS_SPEED=1
# SAYDI_TTS_OUTPUT_FORMAT=wav
# SAYDI_TTS_TIMEOUT_SECONDS=120
# SAYDI_TTS_CONCURRENCY=3
# SAYDI_TTS_LANG=vi
# Voiceover job artifacts (uploads, segments, output MP4) — default: ./voiceover_jobs
# DRAKONSUB_VOICEOVER_JOBS_ROOT=voiceover_jobs
