OPENAI_API_KEY=sk-your-key-here
# OpenAI model for translation + VI loanword fix (Chat Completions only).
# Best: gpt-5.5-2026-04-23 | Also OK: gpt-5.5, o3, gpt-4.1, gpt-4o, o4-mini
# NOT supported: gpt-5.5-pro (Responses API only)
OPENAI_MODEL=gpt-5.5-2026-04-23

# Translation tone for OpenAI: economics | everyday | humor
TRANSLATION_TOPIC=economics

# Translation: segments per OpenAI request (more context = more natural; max 50)
TRANSLATION_BATCH_SIZE=30

# Phrase grouping: max consecutive cues per phrase group sent to GPT (1-20, default 6)
# Larger = more sentence context per group; smaller = more granular grouping
PHRASE_GROUP_MAX_CUES=6

# Second pass to polish stiff/machine-translated subtitles (true/false)
OPENAI_TRANSLATION_POLISH=true

# Subtitle appearance (hex colors: #RRGGBB)
SUBTITLE_FONT_SIZE=55
SUBTITLE_FONT_COLOR=#9333EA
SUBTITLE_BACKGROUND_COLOR=#FFFFFF
SUBTITLE_MARGIN_BOTTOM=32
SUBTITLE_BOX_PADDING=14
SUBTITLE_REFERENCE_HEIGHT=1920

# VI mode: use OpenAI to fix English loanwords mis-transcribed by ASR (true/false)
VI_LOANWORD_OPENAI_FIX=true

# Set to true to print per-group cue text and EN/VI sample pairs in console (false by default)
DRAKONSUB_DEBUG=false

# Vietnamese Subtitle Readability Optimizer
# Shorten verbose Vietnamese text so it fits within the display window.
# Stage 1: rule-based (always fast, zero cost).
# Stage 2: OpenAI rewrite for cues still above hard_cps (opt-in, uses OPENAI_API_KEY).
ENABLE_VI_READABILITY_OPTIMIZER=true
VI_READABILITY_USE_OPENAI=false
VI_READABILITY_TARGET_CPS=17
VI_READABILITY_MAX_CPS=22
VI_READABILITY_HARD_CPS=26

# Vietnamese Subtitle Timing Optimizer
# Adjust cue duration so Vietnamese text is readable at the target reading speed.
# Set to false to disable entirely and keep original English SRT timing.
ENABLE_VI_TIMING_OPTIMIZER=true

# Target reading speed: slow (14 CPS) | normal (17 CPS) | fast (20 CPS)
VI_SUBTITLE_READING_SPEED=normal
